#!/bin/bash
#SBATCH -A cis261275-ai
#SBATCH -p ai
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gpus-per-node=1
#SBATCH --mem=64G
#SBATCH --time=48:00:00
#SBATCH --job-name=gpt2_wikipedia
#SBATCH --output=/anvil/projects/x-cis261275/training/gpt2-wikipedia-%j.out
#SBATCH --error=/anvil/projects/x-cis261275/training/gpt2-wikipedia-%j.err

set -euo pipefail

module purge
module load modtree/gpu
module load conda
source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate /home/x-jhouck1/.conda/envs/pipeline

export PROJECT=/anvil/projects/x-cis261275
export HF_HOME="$PROJECT/training/wikipedia/hf_cache"
export HF_DATASETS_CACHE="$HF_HOME/datasets"
export HUGGINGFACE_HUB_CACHE="$HF_HOME/hub"
export TRANSFORMERS_CACHE="$HF_HOME/transformers"
export TOKENIZERS_PARALLELISM=false
export PYTHONUNBUFFERED=1

# H100 80 GB starting point: effective batch = 32 * 2 = 64 sequences.
# If this OOMs, use 16 and 4. If memory is comfortable, test 64 and 1.
export MICRO_BATCH_SIZE=32
export EVAL_BATCH_SIZE=32
export GRAD_ACCUM_STEPS=2
export NUM_TRAIN_EPOCHS=1
export EVAL_STEPS=5000
export SAVE_STEPS=5000
export LOGGING_STEPS=100
export TRAIN_SEED=42

cd "$PROJECT/training"

echo "Python: $(which python)"
echo "CONDA_PREFIX: ${CONDA_PREFIX:-unset}"
echo "CUDA_VISIBLE_DEVICES: ${CUDA_VISIBLE_DEVICES:-unset}"
nvidia-smi
python -c "import torch, datasets, pyarrow, transformers, accelerate; print('torch', torch.__version__); print('datasets', datasets.__version__); print('pyarrow', pyarrow.__version__); print('transformers', transformers.__version__); print('accelerate', accelerate.__version__)"
mkdir -p "$PROJECT/training/gpt2-wikipedia/seed-${TRAIN_SEED}"
python -m pip freeze > "$PROJECT/training/gpt2-wikipedia/seed-${TRAIN_SEED}/python_environment.txt"

srun python -u train_gpt2_wikipedia.py
