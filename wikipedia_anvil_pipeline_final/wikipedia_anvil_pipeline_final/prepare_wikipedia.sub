#!/bin/bash
#SBATCH -A cis261275-ai
#SBATCH -p ai
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=48:00:00
#SBATCH --job-name=wiki_prepare
#SBATCH --output=/anvil/projects/x-cis261275/training/wiki-prepare-%j.out
#SBATCH --error=/anvil/projects/x-cis261275/training/wiki-prepare-%j.err

set -euo pipefail

module purge
module load modtree/gpu
module load conda
source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate /home/x-jhouck1/.conda/envs/pipeline

export PROJECT=/anvil/projects/x-cis261275
export REPO_DIR="${REPO_DIR:-$PROJECT/training/wikipedia-pipeline}"
export HF_HOME="$PROJECT/training/wikipedia/hf_cache"
export HF_DATASETS_CACHE="$HF_HOME/datasets"
export HUGGINGFACE_HUB_CACHE="$HF_HOME/hub"
export TRANSFORMERS_CACHE="$HF_HOME/transformers"
export PYTHONUNBUFFERED=1

mkdir -p "$PROJECT/training/wikipedia"/{raw,hf_cache} "$PROJECT/training/gpt2-wikipedia"
cd "$REPO_DIR"

echo "Repository: $REPO_DIR"
echo "Python: $(which python)"
python -c "import datasets, pyarrow, huggingface_hub; print('datasets', datasets.__version__); print('pyarrow', pyarrow.__version__); print('huggingface_hub', huggingface_hub.__version__)"
python -m pip freeze > "$PROJECT/training/wikipedia/python_environment-prepare.txt"

# CPU-only preprocessing. No GPU is requested.
srun python -u prepare_wikipedia.py --workers "${SLURM_CPUS_PER_TASK:-8}"
