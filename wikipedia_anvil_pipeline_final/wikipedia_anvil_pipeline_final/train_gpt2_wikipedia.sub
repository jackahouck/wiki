#!/bin/bash
#SBATCH -A cis261275-ai
#SBATCH -p ai
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gpus-per-node=1
#SBATCH --mem=64G
#SBATCH --time=48:00:00
#SBATCH --job-name=gpt2_wikipedia_control
#SBATCH --output=/anvil/projects/x-cis261275/training/gpt2-wikipedia-%j.out
#SBATCH --error=/anvil/projects/x-cis261275/training/gpt2-wikipedia-%j.err

set -euo pipefail

module purge
module load modtree/gpu
module load conda
source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate /home/x-jhouck1/.conda/envs/pipeline

export PROJECT=/anvil/projects/x-cis261275
export REPO_DIR="${REPO_DIR:-$PROJECT/training/wikipedia-pipeline}"
export HF_HOME="$PROJECT/training/wikipedia/hf_cache"
export HF_DATASETS_CACHE="$HF_HOME/datasets"
export HUGGINGFACE_HUB_CACHE="$HF_HOME/hub"
export TRANSFORMERS_CACHE="$HF_HOME/transformers"
export TOKENIZERS_PARALLELISM=false
export PYTHONUNBUFFERED=1

# Same effective training batch as the old 8 x 8 setup: 64 sequences/update.
# This 32 x 2 decomposition should be faster. After a successful run, 64 x 1
# can be benchmarked by overriding these values for BOTH compared models.
export MICRO_BATCH_SIZE="${MICRO_BATCH_SIZE:-32}"
export EVAL_BATCH_SIZE="${EVAL_BATCH_SIZE:-64}"
export GRAD_ACCUM_STEPS="${GRAD_ACCUM_STEPS:-2}"
export NUM_TRAIN_EPOCHS="${NUM_TRAIN_EPOCHS:-1}"
export MAX_STEPS="${MAX_STEPS:--1}"
export EVAL_STEPS="${EVAL_STEPS:-1000}"
export SAVE_STEPS="${SAVE_STEPS:-1000}"
export LOGGING_STEPS="${LOGGING_STEPS:-100}"
export LEARNING_RATE="${LEARNING_RATE:-5e-4}"
export WARMUP_STEPS="${WARMUP_STEPS:-1000}"
export TRAIN_SEED="${TRAIN_SEED:-42}"
export USE_TORCH_COMPILE="${USE_TORCH_COMPILE:-0}"

cd "$REPO_DIR"

echo "Repository: $REPO_DIR"
echo "Python: $(which python)"
echo "CONDA_PREFIX: ${CONDA_PREFIX:-unset}"
echo "CUDA_VISIBLE_DEVICES: ${CUDA_VISIBLE_DEVICES:-unset}"
nvidia-smi
python -c "import torch, datasets, pyarrow, transformers, accelerate; print('torch', torch.__version__); print('datasets', datasets.__version__); print('pyarrow', pyarrow.__version__); print('transformers', transformers.__version__); print('accelerate', accelerate.__version__)"

RUN_DIR="$PROJECT/training/gpt2-wikipedia/control-brackettok-seed-${TRAIN_SEED}"
mkdir -p "$RUN_DIR"
python -m pip freeze > "$RUN_DIR/python_environment.txt"

srun python -u train_gpt2_wikipedia.py
